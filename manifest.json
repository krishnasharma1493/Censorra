{
  "manifest_version": 3,
  "name": "NSFW Tab Closer",
  "version": "1.0",
  "description": "Automatically closes tabs containing NSFW images using Hugging Face AI",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "https://api-inference.huggingface.co/*"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}